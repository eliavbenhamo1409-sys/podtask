NEXT_PUBLIC_SUPABASE_URL=https://jxlrpewoqikpswxmtdma.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Set to "true" to drive every screen from in-memory mock data (no DB writes,
# no OpenAI calls). Leave at "false" for the real Supabase + OpenAI pipeline.
NEXT_PUBLIC_MOCK_MODE=false

# Realtime voice adapter for the interview room. Use "openai" once the
# create-realtime-session edge function and `openai_realtime` secret are in
# place; "mock" simulates a session locally.
NEXT_PUBLIC_REALTIME_ADAPTER=openai

# Guest / "try without email" uses Supabase Anonymous sign-ins.
# Enable in Dashboard: Authentication → Sign In / Providers → Anonymous.
